configuration {
  display-drun: "Applications:";
  display-window: "Windows:";
  display-run: "Run:";
  drun-display-format: "{icon} {name}";
  font: "0xProto Nerd Font Medium 14";
  modi: "window,run,drun";
  show-icons: true;
  icon-theme: "Papirus";
}

@theme "/dev/null"

* {
  bg: rgba(39, 39, 42, 1);
  bg-alt: rgba(63, 63, 70, 1);
  box-alt: rgba(117, 241, 250, 1);

  fg: #ffffff;
  fg-alt: #9aa5b1;

  background-color: @bg;

  border: 0;
  margin: 0;
  padding: 0;
  spacing: 0;
}

window {
  width: 45%;
  padding: 20px 0 0;
  border-radius: 20px;
}

element {
  padding: 12;
  text-color: @fg-alt;
}

element selected {
  background-color: @box-alt;
  text-color: @bg;
  border-radius: 8px;
}

element-text {
  background-color: inherit;
  text-color: inherit;
  vertical-align: 0.5;
}

element-text selected {
  background-color: transparent;
}

element-icon {
  size: 30;
}

element-icon selected {
  background-color: @box-alt;
}

entry {
  background-color: @bg-alt;
  padding: 12;
  text-color: @fg;
  cursor: text;
}

inputbar {
  children: [prompt, entry];
  padding: 10;
  background-color: @bg;
}

listview {
  background-color: transparent;
  columns: 1;
  lines: 8;
  scrollbar: true;
  scrollbar-width: 6px;
  scrollbar-border-radius: 3px;
  scrollbar-handle: 0px 0px 10px 0px;
}

mainbox {
  children: [inputbar, listview];
  background-color: @bg;
}

prompt {
  enabled: true;
  padding: 12 0 0 12;
  background-color: @bg-alt;
  text-color: @fg;
}

scrollbar {
  background-color: transparent;
  handle-color: @box-alt;
  border-radius: 3px;
  handle-width: 6px;
}
